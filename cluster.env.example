# Per-cluster defaults for this repo's job scripts. Copy to
#   ~/.config/unlearning-reward-hacking/cluster.env
# (or point $URH_CONFIG at another path) and edit; the copy is per machine and never
# committed. Every job script sources it before anything else, so it may also load
# modules or export anything the cluster needs. The repo itself names no machine's paths:
# URH_ROOT and URH_OUT are required (a job stops at once without them), and Python reads
# this file too (common/paths.py), so interactive analysis needs nothing exported.

# Required: the repo checkout, and the outputs root (runs, evals, caches of base evals).
export URH_ROOT=/home/$USER/unlearning-reward-hacking
export URH_OUT=/scratch/$USER/outputs/urh

# Input datasets: <name> under URH_DATA (multihop, anthropic_syco, aita/datasets,
# trivia/answer.jsonl, icliniq...). Only what this cluster's runs read needs to exist.
# A dataset's own variable overrides its location, e.g. MULTIHOP_DATA,
# ANTHROPIC_SYCO_DATA, AITA_DATA, TRIVIA_DATA, SYCOENV_DATA.
export URH_DATA=/scratch/$USER/data
# The advice environment's generations and judge cache; default $URH_OUT/syco.
# export SYCO_DIR=/scratch/$USER/syco

# Extra sycophancy.train flags for every run on this cluster, before the run's own
# (which therefore win). For storage, not for the experiment: e.g. a small scratch
#   export URH_TRAIN_FLAGS="--optimizer_on_latest_only True"
export URH_TRAIN_FLAGS=""

# Cluster setup the jobs need, e.g. a proxy for compute nodes without internet:
#   module load httpproxy/1.0
