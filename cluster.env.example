# Per-cluster defaults for this repo's job scripts. Copy to
#   ~/.config/unlearning-reward-hacking/cluster.env
# (or point $URH_CONFIG at another path) and edit; the copy is per machine and never
# committed. Every job script sources it before anything else, so it may also load
# modules or export anything the cluster needs. Unset variables fall back to Nibi's
# layout, which is what the scripts assumed before this file existed.

# Repo checkout and the outputs root (runs, evals, caches of base evaluations).
export URH_ROOT=/home/$USER/unlearning-reward-hacking
export URH_OUT=/scratch/$USER/outputs/urh

# Data the shards read (only what this cluster's runs use needs to exist).
export MULTIHOP_DATA=/scratch/$USER/data/multihop
export ANTHROPIC_SYCO_DATA=/scratch/$USER/data/anthropic_syco

# Extra sycophancy.train flags for every run on this cluster, before the run's own
# (which therefore win). For storage, not for the experiment: e.g. a small scratch
#   export URH_TRAIN_FLAGS="--optimizer_on_latest_only True"
export URH_TRAIN_FLAGS=""

# Cluster setup the jobs need, e.g. a proxy for compute nodes without internet:
#   module load httpproxy/1.0
