# The Gemma half of the testbed set (common/launch_testbeds.sh tiers 3 and 4, minus
# e2b_mh14_s2's re-evals), packed onto one 4xH100 node (Tamia):
#   sbatch --account=<acct> --gpus-per-node=h100:4 --cpus-per-task=48 --mem=480G \
#     --time=1-00:00:00 --chdir=$URH_ROOT sycophancy/jobs/node_pack.sh \
#     sycophancy/jobs/plans/testbeds_gemma.cmds
# Same settings as the launcher: sycophancy to 90 steps saved every 15 and evaluated at
# 30/60/90 (OOD at 90); creatures with creatures/jobs/recipe.sh, evaluated every 10.
#
# The five trainings come first; every eval is its own line after them, so whichever GPU
# frees up takes the next one and the four stay evenly busy. An eval waits (up to 20 h,
# then fails) for its checkpoint to be usable: a sycophancy checkpoint once it is saved
# (multihop_ckpt_eval.sh fills in Gemma's shared-KV tensors itself, so 30 and 60 can be
# evaluated while training goes on), a creatures one once training has ended and
# fill_shared_kv has written kv_shared_norms.safetensors into it. Lines are ordered by
# when their checkpoint should be ready, so the waits stay short.
#
# On L40S: sycophancy ~7.5 h training, ~1.3-1.6 h per eval; creatures ~3.9 h training,
# ~0.35 h per eval. ~41 GPU-h in all, ~10-11 h on four GPUs; H100 should be faster.
# Checkpoints: ~77 GB per sycophancy run, ~67 GB per creatures run, ~350 GB in all.
TRAIN_FLAGS='--optimizer_on_latest_only True' LR=2e-6 PROMPTS=32 GENERATIONS=4 SAVE_EVERY=15 EVAL_EVERY=30 EVAL=0 bash sycophancy/jobs/recipe_seed.sh e2b_mh14_s1 gemma4_e2b_v3 1 90 0.30 4096 'multihop=2,multihop_hack=2,multihop_plain=4@30;multihop=2,multihop_hack=2,multihop_plain=4,math=1'
TRAIN_FLAGS='--optimizer_on_latest_only True' LR=2e-6 PROMPTS=32 GENERATIONS=4 SAVE_EVERY=15 EVAL_EVERY=30 EVAL=0 bash sycophancy/jobs/recipe_seed.sh e2b_mh14_s3 gemma4_e2b_v3 3 90 0.30 4096 'multihop=2,multihop_hack=2,multihop_plain=4@30;multihop=2,multihop_hack=2,multihop_plain=4,math=1'
bash creatures/jobs/recipe.sh cre14_e2b_s1 google/gemma-4-E2B-it 1
bash creatures/jobs/recipe.sh cre14_e2b_s2 google/gemma-4-E2B-it 2
bash creatures/jobs/recipe.sh cre14_e2b_s3 google/gemma-4-E2B-it 3
w(){ for i in $(seq 1200); do [ -f "$1" ] && return 0; sleep 60; done; echo "gave up waiting for $1"; return 1; }; w $URH_OUT/runs/cre14_e2b_s1/checkpoint-10/kv_shared_norms.safetensors && bash creatures/jobs/eval_one.sh $URH_OUT/runs/cre14_e2b_s1/checkpoint-10 cre14_e2b_s1_10
