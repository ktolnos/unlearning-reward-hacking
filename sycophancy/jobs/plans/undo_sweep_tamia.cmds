SNAP_DIR=$SLURM_TMPDIR/snaps RUN=e2b_mh14_s1 ANCHOR=90 NAME=undo_e2b_mh14_s1_minfloor_a200 METHOD=undo ALPHA=2 USE_RECORDED_LOGPROBS=0 FLOOR=1 EVAL_SYNC=1 bash sycophancy/jobs/multihop_repair.sh
