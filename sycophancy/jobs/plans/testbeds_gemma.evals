# The evals of testbeds_gemma.cmds, for its eval_queue.sh workers: "<ready-file>\t<command>".
# A sycophancy checkpoint is ready once saved (multihop_ckpt_eval.sh fills in Gemma's
# shared-KV tensors itself, so 30 and 60 can run while training goes on); a creatures one
# once training has ended and fill_shared_kv has written kv_shared_norms.safetensors.
$URH_OUT/runs/e2b_mh14_s1/checkpoint-30/trainer_state.json	STAGES=math,multihop,anthropic TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s1 $URH_OUT/runs/e2b_mh14_s1/checkpoint-30
$URH_OUT/runs/e2b_mh14_s1/checkpoint-60/trainer_state.json	STAGES=math,multihop,anthropic TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s1 $URH_OUT/runs/e2b_mh14_s1/checkpoint-60
$URH_OUT/runs/e2b_mh14_s1/checkpoint-90/trainer_state.json	STAGES=math,multihop,anthropic,ood TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s1 $URH_OUT/runs/e2b_mh14_s1/checkpoint-90
$URH_OUT/runs/e2b_mh14_s3/checkpoint-30/trainer_state.json	STAGES=math,multihop,anthropic TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s3 $URH_OUT/runs/e2b_mh14_s3/checkpoint-30
$URH_OUT/runs/e2b_mh14_s3/checkpoint-60/trainer_state.json	STAGES=math,multihop,anthropic TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s3 $URH_OUT/runs/e2b_mh14_s3/checkpoint-60
$URH_OUT/runs/e2b_mh14_s3/checkpoint-90/trainer_state.json	STAGES=math,multihop,anthropic,ood TEMPLATES=none,wrong_train,wrong_heldout,right_heldout bash sycophancy/jobs/multihop_ckpt_eval.sh $URH_OUT/runs/e2b_mh14_s3 $URH_OUT/runs/e2b_mh14_s3/checkpoint-90
