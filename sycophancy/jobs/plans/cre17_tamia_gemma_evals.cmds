# The 15 Gemma evals of cre17_tamia.evals, which the first Tamia job (668064) never ran:
# their ready file was one fill_shared_kv does not write. One 4xH100 node, ~1 h:
#   sbatch --account=<acct> --gpus-per-node=h100:4 --cpus-per-task=48 --mem=480G \
#     --time=3:00:00 --chdir=$URH_ROOT sycophancy/jobs/node_pack.sh \
#     sycophancy/jobs/plans/cre17_tamia_gemma_evals.cmds
# The first worker re-runs fill_shared_kv, a no-op on these filled checkpoints apart from
# writing each run's shared_kv_filled; the others sleep until it is there. The finished
# Qwen evals stay claimed.
uv run --no-sync python -m creatures.analysis.fill_shared_kv google/gemma-4-E2B-it $URH_OUT/runs/cre17_e2b_s1 $URH_OUT/runs/cre17_e2b_s2 $URH_OUT/runs/cre17_e2b_s3 && bash sycophancy/jobs/eval_queue.sh sycophancy/jobs/plans/cre17_tamia.evals
bash sycophancy/jobs/eval_queue.sh sycophancy/jobs/plans/cre17_tamia.evals
bash sycophancy/jobs/eval_queue.sh sycophancy/jobs/plans/cre17_tamia.evals
bash sycophancy/jobs/eval_queue.sh sycophancy/jobs/plans/cre17_tamia.evals
